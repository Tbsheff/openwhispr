# Postgres connection string
DATABASE_URL=postgresql://openwhispr:openwhispr@localhost:5432/openwhispr

# Server
PORT=3001
SERVER_URL=https://mcp.yourcompany.com

# GitHub OAuth App (Settings → Developer settings → OAuth Apps → New)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub org — only members of this org can authenticate
GITHUB_ORG=your-github-org

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
